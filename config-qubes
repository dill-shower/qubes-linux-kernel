## Qubes specific config settings for Dom0 (Asus ROG SCAR 17 / Ryzen 5900HX).
##
## Lines starting with ## are comments.

################################################################################
## Базовые экспертные опции и сжатие XZ
################################################################################

CONFIG_EXPERT=y

# CONFIG_KERNEL_GZIP is not set
# CONFIG_KERNEL_XZ is not set
CONFIG_KERNEL_ZSTD=y

CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

################################################################################
## Защита ядра Qubes OS (Базовый Hardening)
################################################################################

CONFIG_GCC_PLUGINS=y
CONFIG_GCC_PLUGIN_LATENT_ENTROPY=y
CONFIG_INIT_STACK_ALL_ZERO=y

CONFIG_ARCH_MMAP_RND_BITS=32
CONFIG_ARCH_MMAP_RND_COMPAT_BITS=16

# CONFIG_KEXEC is not set
# CONFIG_CRASH_DUMP is not set

CONFIG_LEGACY_VSYSCALL_NONE=y
CONFIG_SECURITY_DMESG_RESTRICT=y
CONFIG_INTEL_IOMMU_DEFAULT_ON=y

# CONFIG_PROC_KCORE is not set

CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_INIT_ON_FREE_DEFAULT_ON=y

CONFIG_PANIC_ON_OOPS=y
CONFIG_PANIC_TIMEOUT=-1

CONFIG_SCHED_STACK_END_CHECK=y
CONFIG_IO_STRICT_DEVMEM=y
CONFIG_SECURITY_YAMA=y

# CONFIG_HIBERNATION is not set

CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y

# CONFIG_DEFAULT_SECURITY_SELINUX is not set
CONFIG_DEFAULT_SECURITY_DAC=y
CONFIG_LSM="landlock,yama,loadpin,safesetid,integrity"

CONFIG_PARAVIRT_SPINLOCKS=y

# CONFIG_DEBUG_WX is not set

CONFIG_SECURITY_APPARMOR=y

################################################################################
## USB-драйверы модулями (Критично для перехвата в sys-usb до загрузки в Dom0)
################################################################################

CONFIG_USB_UHCI_HCD=m
CONFIG_USB_OHCI_HCD=m
CONFIG_USB_EHCI_HCD=m
CONFIG_USB_XHCI_HCD=m

CONFIG_USB_GADGET=m
CONFIG_USB_CONFIGFS=m
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
CONFIG_USB_DUMMY_HCD=m

################################################################################
## Драйверы гипервизора Xen
################################################################################

CONFIG_XEN_BALLOON_MEMORY_HOTPLUG=y
CONFIG_XEN_UNPOPULATED_ALLOC=y
CONFIG_XEN_GRANT_DMA_ALLOC=y
CONFIG_XEN_GNTDEV_DMABUF=y
CONFIG_EFI_VARS_PSTORE=y
CONFIG_MODPROBE_PATH="/sbin/modprobe"
# CONFIG_INTEL_PMC_CORE is not set

# CONFIG_XEN_VIRTIO is not set

CONFIG_PREEMPT=y

CONFIG_PHYSICAL_START=0x200000
CONFIG_PHYSICAL_ALIGN=0x200000

# CONFIG_DRM_ACCEL_AMDXDNA is not set

################################################################################
## Настройки
################################################################################

# 1. PCIe Hotplug (Необходим для сна dGPU D3cold и док-станций)
CONFIG_HOTPLUG_PCI=y
CONFIG_HOTPLUG_PCI_PCIE=y
CONFIG_HOTPLUG_PCI_ACPI=y

# 2. Энергосбережение шины PCIe
CONFIG_PCIEASPM=y
CONFIG_PCIEASPM_POWERSAVE=y

# 3. Платформа AMD, датчики температуры ядер и контроллер питания SoC
CONFIG_X86_AMD_PLATFORM_DEVICE=y
CONFIG_AMD_PMC=m
CONFIG_HWMON=y
CONFIG_SENSORS_K10TEMP=m
CONFIG_ACPI_FAN=y
CONFIG_ACPI_THERMAL=y
CONFIG_THERMAL_HWMON=y

# 4. Драйверы кулеров и профилей питания ноутбуков Asus ROG
CONFIG_ACPI_WMI=m
CONFIG_WMI_BMOF=m
CONFIG_ASUS_WMI=m
CONFIG_ASUS_NB_WMI=m
CONFIG_ASUS_ARMOURY=m

################################################################################
## МАКСИМАЛЬНЫЙ HARDENING БЕЗ УЩЕРБА БОЛЕЕ 3% ПРОИЗВОДИТЕЛЬНОСТИ
################################################################################

# 1. Зануление регистров CPU перед выходом из функций (ломает ROP-эксплойты и утечки)
CONFIG_ZERO_CALL_USED_REGS=y

# 2. Рандомизация полей структур ядра компилятором GCC (Randstruct)
CONFIG_RANDSTRUCT_FULL=y
# CONFIG_RANDSTRUCT_NONE is not set

# 3. Защита от Cold Boot атак (затирание RAM нулями через UEFI при выключении/ребуте)
CONFIG_RESET_ATTACK_MITIGATION=y

# 4. Контроль целостности таблиц страниц памяти (Double Mapping / Use-After-Free)
CONFIG_PAGE_TABLE_CHECK=y
CONFIG_PAGE_TABLE_CHECK_ENFORCE=y

# 5. Проверка целостности очередей и списков ядра
CONFIG_DEBUG_LIST=y
CONFIG_DEBUG_SG=y
CONFIG_DEBUG_NOTIFIERS=y

# 6. Аппаратные mitigations микроархитектуры AMD Zen 3 (Inception / Retbleed)
CONFIG_MITIGATION_SRSO=y
CONFIG_MITIGATION_RETBLEED=y
CONFIG_MITIGATION_IBPB_ENTRY=y

